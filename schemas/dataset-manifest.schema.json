{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metasoft.github.io/mbp/schemas/dataset-manifest.schema.json",
  "title": "Metasoft Dataset Manifest",
  "description": "Per-file hashes, counts, seed, and a top-level digest. Generation must be deterministic: same generator_version + same seed => identical bytes => identical sha256.",
  "type": "object",
  "required": ["dataset_version", "seed", "generator_version", "case_count", "event_count", "files", "sha256"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
    "seed": { "type": "integer" },
    "generator_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
    "case_count": { "type": "integer", "minimum": 1 },
    "event_count": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "case_count", "event_count", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "case_count": { "type": "integer", "minimum": 0 },
          "event_count": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Top-level digest over the manifest content." }
  }
}
