{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metasoft.github.io/mbp/schemas/benchmark.schema.json",
  "title": "Metasoft Benchmark Manifest",
  "description": "Top-level manifest declaring a benchmark's identity, dataset, runner, metrics, and baselines.",
  "type": "object",
  "required": ["benchmark", "dataset", "runner", "metrics"],
  "additionalProperties": false,
  "properties": {
    "benchmark": {
      "type": "object",
      "required": ["id", "name", "version", "protocol_version", "mode", "domain"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
        "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
        "mode": { "enum": ["OPEN_SUITE", "HIDDEN_SUITE"] },
        "domain": { "type": "string", "minLength": 2, "maxLength": 60 }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["version", "cases", "events", "hash"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
        "cases": { "type": "integer", "minimum": 0, "description": "Draft/hidden skeletons may use 0; a real benchmark dataset is non-empty." },
        "events": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "seed": { "type": "integer" }
      }
    },
    "runner": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" }
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" }
        }
      }
    }
  }
}
